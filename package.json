{
  "name": "auto-editor-916",
  "version": "1.0.0",
  "description": "Personal local-first automatic video editor for 9:16 TikTok / Instagram Reels",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n \"API,VITE\" -c \"blue,magenta\" \"node server/server.js\" \"vite\"",
    "server": "node server/server.js",
    "vite": "vite",
    "build": "vite build",
    "test": "node scripts/test-all-cases.js",
    "render": "node scripts/render.js",
    "test-render": "node scripts/test-render.js",
    "setup-assets": "node scripts/setup-fonts-and-assets.js && node scripts/create-test-assets.js"
  },
  "keywords": [
    "remotion",
    "ffmpeg",
    "video-editor",
    "reels",
    "tiktok",
    "9-16"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@remotion/bundler": "^4.0.512",
    "@remotion/media-utils": "^4.0.512",
    "@remotion/player": "^4.0.512",
    "@remotion/renderer": "^4.0.512",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "ffmpeg-static": "^5.2.0",
    "ffprobe-static": "^3.1.0",
    "multer": "^1.4.5-lts.1",
    "open": "^10.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "remotion": "^4.0.512"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "lucide-react": "^0.475.0",
    "vite": "^6.2.0"
  }
}
